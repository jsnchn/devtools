{
  "hooks": {
    "UserPromptSubmit": [
      {
        "name": "pushover-prompt",
        "command": "~/bin/cc-pushover.sh",
        "args": ["Claude Prompt", "$CLAUDE_DESCRIPTION"]
      }
    ],
    "PreToolUse": [
      {
        "name": "pushover-pre",
        "command": "~/bin/cc-pushover.sh",
        "args": ["Claude PreToolUse", "Tool: $TOOL_NAME"]
      }
    ],
    "PostToolUse": [
      {
        "name": "pushover-post",
        "command": "~/bin/cc-pushover.sh",
        "args": ["Claude PostToolUse", "Tool: $TOOL_NAME Status: $STATUS"]
      }
    ]
  }
}

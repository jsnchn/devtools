{
  "$schema": "https://opencode.ai/config.json",
  "theme": "ayu",
  "autoupdate": true,
  "plugin": [
    "@mohak34/opencode-notifier@latest"
  ],
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "{file:~/.devtools/config/secrets/context7-api-key}"
      ],
      "enabled": true
    }
  }
}
